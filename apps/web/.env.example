SUPABASE_URL=https://piopuidmmzvewjeeezfv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Get from gt-tools dashboard → API

# ============================================================================
# Supabase — NEW perantauglobal (jeadtvxgxmqnsqwxjmhj, Dayalima Pro)
# Dual-write shadow via /api/apply. Anon key (RLS-enforced), never service-role.
# ============================================================================
SUPABASE_URL_V2=https://jeadtvxgxmqnsqwxjmhj.supabase.co
SUPABASE_ANON_KEY_V2=                 # Publishable key sb_publishable_...

# Browser-exposed V2 keys (signInWithOtp from client). Same values.
NEXT_PUBLIC_SUPABASE_URL_V2=https://jeadtvxgxmqnsqwxjmhj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_V2=     # Same publishable key

# Platform app base URL — magic-link emailRedirectTo points here so session
# lands on the platform domain. Uses implicit flow so no PKCE cross-origin
# code_verifier issue. Prod: https://app.perantauglobal.com
NEXT_PUBLIC_PLATFORM_URL=https://app.perantauglobal.com

