# ============================================================================
# Supabase — perantauglobal (jeadtvxgxmqnsqwxjmhj, Dayalima Pro)
# Anon key only. RLS-enforced. Service-role NEVER in apps/web.
# ============================================================================
SUPABASE_URL_V2=https://jeadtvxgxmqnsqwxjmhj.supabase.co
SUPABASE_ANON_KEY_V2=                 # Publishable key sb_publishable_...

# Browser-exposed keys (signInWithOtp from client). Same values.
NEXT_PUBLIC_SUPABASE_URL_V2=https://jeadtvxgxmqnsqwxjmhj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_V2=     # Same publishable key

# Platform app base URL — magic-link emailRedirectTo points here so session
# lands on the platform domain. Uses implicit flow so no PKCE cross-origin
# code_verifier issue. Prod: https://app.perantauglobal.com
NEXT_PUBLIC_PLATFORM_URL=https://app.perantauglobal.com

# ============================================================================
# CV di depan — apply-step CV fit preview
# Shared secret authorizing the grade-cv-preview edge function. Server-only
# (never NEXT_PUBLIC). Must MATCH the CV_PREVIEW_SECRET set on the grade-cv-preview
# edge function (Supabase → Edge Functions → secrets). Unset = feature simply
# off: /api/lowongan/[slug]/cv-preview returns no fit and the card never shows.
# ============================================================================
CV_PREVIEW_SECRET=

# ============================================================================
# Cloudflare Turnstile — bot protection on the apply funnel (managed, invisible)
# Both set on PRODUCTION only (enforced on prod; feature simply off elsewhere).
#   - NEXT_PUBLIC_TURNSTILE_SITE_KEY: public, inlined in the client bundle. Unset
#     = the widget never renders and execute() resolves null.
#   - TURNSTILE_SECRET_KEY: server-only. Unset = verifyTurnstile() is a no-op
#     ("off"), so cv-preview + submit proceed without a Turnstile check.
# Widget hostname allowlist (Cloudflare dashboard): www.perantauglobal.com.
# ============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================================
# Analytics + tracking
# ============================================================================
NEXT_PUBLIC_GTM_ID=GTM-NK3TM7K7

META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ============================================================================
# Error reporting (optional)
# ============================================================================
SENTRY_DSN=
