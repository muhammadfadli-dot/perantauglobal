{
  "name": "@perantauglobal/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./types": "./src/types.ts",
    "./schemas/*": "./schemas/*",
    "./schemas/requirements": "./schemas/requirements/index.ts",
    "./schemas/requirements/library": "./schemas/requirements/library.ts",
    "./schemas/documents": "./schemas/documents/index.ts",
    "./schemas/cv": "./schemas/cv/index.ts"
  },
  "scripts": {
    "migrate": "echo 'Run via Supabase MCP or CLI — see migrations/README.md'",
    "types": "echo 'Run via Supabase MCP generate_typescript_types'",
    "lint": "echo 'TODO'",
    "typecheck": "tsc --noEmit",
    "backfill": "tsx scripts/backfill.ts",
    "backfill-content": "tsx scripts/backfill-position-content.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
