# apps/demand — Daya Talenta Global demand-side site
# Public marketing site. ANON key only — never put the service role key here.
# The talent-pool counter runs on a hardcoded placeholder until migration 0094
# (public.get_talent_pool_stats) is applied.

# REQUIRED for /api/inquiry (employer lead capture -> employer_inquiries).
# Without these the form still opens WhatsApp, but no lead is stored.
SUPABASE_URL_V2=https://jeadtvxgxmqnsqwxjmhj.supabase.co
SUPABASE_ANON_KEY_V2=

# Client-side counterparts (unused today; mirrors the other apps)
NEXT_PUBLIC_SUPABASE_URL_V2=https://jeadtvxgxmqnsqwxjmhj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY_V2=

# OPTIONAL: one email to BD per stored lead (src/lib/email.ts). Dormant unless
# BOTH are set. Key = same Resend account as apps/web (perantauglobal.com is
# the verified sender domain).
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=

# Google Tag Manager (wire the DTG container before enabling tracking)
# NEXT_PUBLIC_GTM_ID=
