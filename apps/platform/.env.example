# Supabase — perantauglobal project (Dayalima Pro)
NEXT_PUBLIC_SUPABASE_URL=https://jeadtvxgxmqnsqwxjmhj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # Publishable key sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=            # Service role — admin actions + requireCandidate() self-heal

# ============================================================================
# Analytics + tracking — MUST share same Pixel ID + GTM container with apps/web
# so cross-domain attribution works (perantauglobal.com → app.perantauglobal.com).
# Pixel + CAPI fire on portal milestones: signup verify, application submit,
# profile complete, etc.
# ============================================================================
NEXT_PUBLIC_GTM_ID=GTM-NK3TM7K7

META_PIXEL_ID=                        # Same value as apps/web
META_CAPI_ACCESS_TOKEN=               # Same value as apps/web
META_TEST_EVENT_CODE=                 # Optional, dev/preview only

# Sentry (optional)
SENTRY_DSN=

# ============================================================================
# Xendit — pembayaran Akademi (Paspor PG). Test keys dulu; Live setelah KYC.
# Server-only (JANGAN commit). XENDIT_WEBHOOK_TOKEN juga di-set sebagai Supabase
# Edge Function secret (untuk xendit-webhook), bukan cuma di Next runtime.
# ============================================================================
XENDIT_SECRET_KEY=                    # xnd_development_... (test) / xnd_production_...
XENDIT_WEBHOOK_TOKEN=                 # Xendit dashboard -> Webhooks -> verification token
NEXT_PUBLIC_APP_URL=https://app.perantauglobal.com  # redirect sukses/gagal Xendit
